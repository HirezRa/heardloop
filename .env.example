# Copy to .env (or run scripts/new-env.ps1) and fill in. Never commit .env.

# PostgreSQL
POSTGRES_PASSWORD=<generate-a-long-random-password>

# Base64 of 32 random bytes. Used for AES-256-GCM encryption of LinkedIn tokens.
# Losing it means re-connecting every LinkedIn account. Keep a copy outside the repo.
HEARDLOOP_TOKEN_KEY=<base64-32-bytes>

# LinkedIn app (https://www.linkedin.com/developers/apps)
LINKEDIN_CLIENT_ID=<client-id>
LINKEDIN_CLIENT_SECRET=<client-secret>
LINKEDIN_REDIRECT_URI=http://localhost:8380/api/v1/linkedin/callback
# Optional. Empty = the version pinned in code (backend/heardloop/config.py).
LINKEDIN_API_VERSION=

# production | development. Leave on production: "development" turns on the interactive API docs (/api/docs).
APP_ENV=production
LOG_LEVEL=INFO

# Session cookie "Secure" flag. Keep true (browsers accept it on http://localhost).
COOKIE_SECURE=true
# Idle timeout (hours) and absolute lifetime (days) of a sign-in session.
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7

# How often the worker looks for due posts (seconds).
WORKER_POLL_SECONDS=15

# Interface language: en (English, default) or he (Hebrew, right-to-left).
UI_LANGUAGE=en

# Links in notification e-mails and webhook payloads.
APP_BASE_URL=http://localhost:8380

# E-mail notifications (optional). Leave SMTP_HOST empty for in-app notifications only.
# SMTP_SECURITY: starttls (port 587), ssl (port 465) or none (local relay only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# Backups (the `backup` service). Files go to BACKUP_DIR on the host; .env itself is never backed up.
# Folder for backup files, relative to the compose file or absolute.
BACKUP_DIR=./backups
# Hour of day (UTC, 0-23) the nightly backup runs.
BACKUP_HOUR_UTC=01
# Delete sets older than this many days ...
BACKUP_KEEP_DAYS=30
# ... but always keep at least this many successful sets.
BACKUP_KEEP_MIN=7
# Optional; if set, backups are encrypted and useless without it - store it with HEARDLOOP_TOKEN_KEY.
BACKUP_PASSPHRASE=

# Optional check for a newer GitHub release (worker every 12 hours; never installs from the app).
UPDATE_CHECK=true
# owner/repo only; the host is always api.github.com.
UPDATE_CHECK_REPO=HirezRa/heardloop
# Leave empty for the public repository. Fine-grained token only if the repo is private.
UPDATE_CHECK_TOKEN=
# Dev-only: when APP_ENV=development, pretend this install reports this version (update-check tests).
# HEARDLOOP_VERSION_OVERRIDE=
